DATABASE_URL=
JWT_SECRET=
GEMINI_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Backend port. Render sets this automatically at runtime — leave unset locally to use 4000.
PORT=

# Comma-separated list of allowed frontend origins, e.g.:
# FRONTEND_URL=https://your-app.pages.dev,http://localhost:5173
# Leave unset to allow all origins (useful for local dev before the production URL is known).
FRONTEND_URL=
